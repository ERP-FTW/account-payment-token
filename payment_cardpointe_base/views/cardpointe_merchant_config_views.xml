<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cardpointe_merchant_config_list" model="ir.ui.view">
        <field name="name">cardpointe.merchant.config.list</field>
        <field name="model">cardpointe.merchant.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="mid"/>
                <field name="gateway_base_url"/>
            </list>
        </field>
    </record>

    <record id="view_cardpointe_merchant_config_form" model="ir.ui.view">
        <field name="name">cardpointe.merchant.config.form</field>
        <field name="model">cardpointe.merchant.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="mid"/>
                        <field name="gateway_base_url"/>
                        <field name="gateway_username"/>
                        <field name="gateway_password" password="True"/>
                        <field name="tokenizer_url"/>
                        <field name="debug_logging"/>
                        <field name="timeout_connect"/>
                        <field name="timeout_read"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cardpointe_merchant_config" model="ir.actions.act_window">
        <field name="name">CardPointe Merchant Configs</field>
        <field name="res_model">cardpointe.merchant.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cardpointe_merchant_config"
              name="CardPointe Merchant Configs"
              action="action_cardpointe_merchant_config"
              groups="base.group_system"/>
</odoo>
