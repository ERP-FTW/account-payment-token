<templates xml:space="preserve">
    <t t-name="pos_cardpointe_poc.CardPointeManualEntryPopup">
        <Dialog title="props.title" size="'lg'">
            <div class="d-flex flex-column gap-3">
                <div class="alert alert-info py-2 mb-0">
                    Enter the card in the CardPointe hosted iframe below. Odoo should receive only the token, not the card number or CVV.
                </div>

                <div>
                    <label class="form-label fw-bold">Transaction type</label>
                    <select class="form-select" t-model="state.ecomind" t-att-disabled="state.submitInProgress">
                        <t t-foreach="props.allowedEcominds" t-as="item" t-key="item[0]">
                            <option t-att-value="item[0]"><t t-esc="item[1]"/></option>
                        </t>
                    </select>
                </div>

                <div t-if="!props.tokenizerUrl" class="alert alert-danger mb-0">
                    Missing CardPointe tokenizer URL. Check the linked CardPointe merchant config.
                </div>

                <iframe t-if="props.tokenizerUrl"
                        t-att-src="props.tokenizerUrl"
                        t-on-load="onIframeLoad"
                        style="width:100%;height:430px;border:1px solid #d6d6d6;border-radius:6px;background:white;"
                        title="CardPointe Hosted iFrame"/>

                <div t-if="props.tokenizerUrl and !state.iframeLoaded" class="text-muted small">
                    Loading CardPointe tokenizer iframe...
                </div>

                <div t-if="state.lastMessageOrigin" class="text-muted small">
                    Last tokenizer message origin: <t t-esc="state.lastMessageOrigin"/>
                </div>

                <div t-if="state.tokenError" class="alert alert-warning py-2 mb-0">
                    <t t-esc="state.tokenError"/>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="cancel" t-att-disabled="state.submitInProgress">
                    <t t-esc="props.cancelLabel"/>
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="pos_cardpointe_poc.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[contains(@class, 'partner-button')]" position="after">
            <button t-if="currentOrder and currentOrder.selected_paymentline and currentOrder.selected_paymentline.payment_method_id.use_payment_terminal === 'cardpointe_poc' and currentOrder.selected_paymentline.payment_method_id.cardpointe_manual_entry_enabled and currentOrder.selected_paymentline.amount &gt; 0 and currentOrder.selected_paymentline.payment_status !== 'done'"
                    class="button btn btn-light py-3 text-start"
                    t-on-click="() => this.onClickCardPointeManualEntry()">
                <i class="fa fa-credit-card me-2"/>Manual Entry
            </button>
        </xpath>
    </t>
</templates>
