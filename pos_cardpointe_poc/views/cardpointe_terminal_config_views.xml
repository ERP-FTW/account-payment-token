<odoo>
    <record id="view_pos_cardpointe_terminal_config_form" model="ir.ui.view">
        <field name="name">pos.cardpointe.terminal.config.form</field>
        <field name="model">pos.cardpointe.terminal.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connect"
                            string="Test Connect"
                            type="object"
                            class="oe_highlight"
                            groups="base.group_system"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="base_url"/>
                        <field name="merchant_id"/>
                        <field name="merchant_config_id"/>
                        <field name="device_type"/>
                        <field name="print_receipt_on_terminal"
                               attrs="{'invisible': [('device_type', '!=', 'clover_flex')]}"/>
                        <field name="device_serial"/>
                        <field name="auth_key" password="True"/>
                        <field name="request_timeout_seconds"/>
                    </group>
                    <group string="Signature Policy">
                        <field name="signature_mode"/>
                        <field name="signature_threshold_amount"
                               attrs="{'invisible': [('signature_mode', '!=', 'over_threshold')], 'required': [('signature_mode', '=', 'over_threshold')]}"/>
                        <field name="signature_capture_method"
                               attrs="{
                                 'invisible': [('signature_mode', '=', 'never')]
                               }"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_cardpointe_terminal_config_tree" model="ir.ui.view">
        <field name="name">pos.cardpointe.terminal.config.tree</field>
        <field name="model">pos.cardpointe.terminal.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id"/>
                <field name="merchant_id"/>
                <field name="device_serial"/>
                <field name="signature_mode"/>
                <field name="request_timeout_seconds"/>
            </tree>
        </field>
    </record>

    <record id="action_pos_cardpointe_terminal_config" model="ir.actions.act_window">
        <field name="name">CardPointe Terminal Configs</field>
        <field name="res_model">pos.cardpointe.terminal.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_pos_cardpointe_terminal_config"
              name="CardPointe Terminal Configs"
              parent="point_of_sale.menu_point_config_product"
              action="action_pos_cardpointe_terminal_config"
              groups="point_of_sale.group_pos_manager"/>
</odoo>
