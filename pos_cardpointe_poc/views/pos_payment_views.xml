<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_form_cardpointe_hold" model="ir.ui.view">
        <field name="name">pos.payment.form.cardpointe.hold</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header invisible="not cardpointe_refund_hold">
                    <button name="action_cardpointe_clear_refund_hold" type="object"
                            string="Clear CardPointe return hold" groups="point_of_sale.group_pos_manager"
                            confirm="Clear the hold only after CardPointe reporting shows what the held return did. Continue?"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='transaction_id']" position="after">
                <field name="cardpointe_refund_hold" invisible="not cardpointe_refund_hold"/>
            </xpath>
        </field>
    </record>
</odoo>
