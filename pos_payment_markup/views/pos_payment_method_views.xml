<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_form_markup" model="ir.ui.view">
        <field name="name">POS Payment Markup Provider Mapping</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="markup_mode"/>
                <field name="manual_markup_percent" invisible="markup_mode != 'percentage'"/>
                <field name="markup_fixed_amount" invisible="markup_mode != 'fixed'"/>
                <field name="manual_markup_product_id" required="markup_mode != 'disabled'"/>
                <field name="manual_markup_tax_included"/>
                <field name="markup_provider_id"/>
                <label for="markup_card_type" string="Markup card evidence"/>
                <field name="markup_card_type" placeholder="credit"/>
                <div class="text-muted">Only explicit credit/card evidence enables markup; display names are never used.</div>
            </field>
        </field>
    </record>
</odoo>
