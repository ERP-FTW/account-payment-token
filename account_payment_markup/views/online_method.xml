<odoo>
    <record id="online_method_fees" model="ir.ui.view">
        <field name="name">payment.method.manual.markup</field>
        <field name="model">payment.method</field>
        <field name="inherit_id" ref="payment.payment_method_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group name="checkout_markup" string="Checkout fee">
                    <field name="markup_percent"/>
                    <field name="markup_product_id" required="markup_percent &gt; 0"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
