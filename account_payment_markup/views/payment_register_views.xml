<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_payment_register_form_markup" model="ir.ui.view">
        <field name="name">account.payment.register.form.markup</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="markup_provider_id"/>
                <field name="markup_net_amount" readonly="1"/>
                <field name="markup_tax_amount" readonly="1"/>
                <field name="markup_gross_amount" readonly="1"/>
                <field name="markup_total_amount" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>