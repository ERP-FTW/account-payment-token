<odoo>
    <template id="payment_checkout_markup_disclosure" inherit_id="payment.method_form">
        <xpath expr="//label[hasclass('o_payment_option_label')]" position="after">
            <t t-set="fee" t-value="pm_sudo._checkout_markup(provider_sudo, amount, currency, provider_sudo.env['res.partner'].browse(partner_id), invoice or sale_order or website_sale_order) if mode != 'validation' and amount and currency else {}"/>
            <t t-call="account_payment_markup.payment_markup_disclosure"/>
        </xpath>
        <xpath expr="//div[@name='o_payment_inline_form']/t[@t-call]" position="inside">
            <t t-set="amount" t-value="fee.get('total', amount)"/>
        </xpath>
    </template>
    <template id="payment_token_markup_disclosure" inherit_id="payment.token_form">
        <xpath expr="//label[hasclass('o_payment_option_label')]" position="after">
            <t t-set="fee" t-value="token_sudo.payment_method_id._checkout_markup(token_sudo.provider_id, amount, currency, token_sudo.partner_id, invoice or sale_order or website_sale_order) if mode != 'validation' and amount and currency else {}"/>
            <t t-call="account_payment_markup.payment_markup_disclosure"/>
        </xpath>
    </template>
    <template id="payment_markup_disclosure">
        <span t-if="fee" class="o_manual_payment_fee small">
            <t t-out="fee['product'].display_name"/>:
            <span t-out="fee['fee']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
            · Total <strong t-out="fee['total']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
        </span>
    </template>
</odoo>
