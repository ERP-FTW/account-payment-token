<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_markup" model="ir.ui.view">
        <field name="name">Payment Provider Card Markup</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group string="Payment markup">
                    <field name="markup_enabled"/>
                    <field name="markup_percent" attrs="{'required': [('markup_enabled', '=', True)]}"/>
                    <field name="markup_tax_included"/>
                    <field name="markup_product_id" attrs="{'required': [('markup_enabled', '=', True)]}" domain="[('detailed_type', '=', 'service')]"/>
                    <label for="markup_product_id" string="Setup"/>
                    <div class="text-muted">Select a service product configured with the intended income account and taxes; no live product or tax is created by this module.</div>
                </group>
            </group>
        </field>
    </record>
</odoo>
